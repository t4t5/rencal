{
  "name": "renCal",
  "id": "dev.rencal.app",
  "version": "0.9.2",
  "build": 1,
  "rust": "native",
  "appearance": "dark",
  "window": {
    "title": "renCal",
    "minSize": {
      "width": 300,
      "height": 600
    }
  },
  "singleInstance": true,
  "resolve": {
    "alias": {
      "@js-temporal/polyfill": "./lib/temporal.ts",
      "@": "./"
    }
  },
  "theme": "theme.json",
  "tailwind": {
    "fontSize": {
      "2xs": [11, 1.27]
    },
    "breakpoints": {
      "xs": 380
    }
  }
}
