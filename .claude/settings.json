{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/post-edit.sh",
            "timeout": 120,
            "statusMessage": "Type-checking edit…"
          }
        ]
      }
    ]
  }
}
