{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "renCal",
  "version": "0.0.1",
  "identifier": "org.ren.rencal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "renCal",
        "width": 1200,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://rencal.org/plugin-previews/ data:; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'none'; connect-src 'self' ipc: http://ipc.localhost ws:; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https://rencal.org/plugin-previews/ data: blob:; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "providers/caldir-provider-google",
      "providers/caldir-provider-icloud",
      "providers/caldir-provider-outlook",
      "providers/caldir-provider-caldav",
      "providers/caldir-provider-webcal",
      "icons/128x128.png"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/libexec/renCal/providers": "providers"
        }
      },
      "deb": {
        "depends": ["libnotify-bin"],
        "desktopTemplate": "linux/rencal.desktop",
        "files": {
          "/usr/lib/renCal/providers": "providers",
          "/usr/bin/rencal-notifierd": "target/release/rencal-notifierd",
          "/usr/lib/systemd/user/rencal-notifierd.service": "notifierd/rencal-notifierd.service",
          "/usr/share/icons/hicolor/scalable/apps/rencal.svg": "icons/linux/icon.svg"
        }
      },
      "rpm": {
        "depends": ["libnotify"],
        "desktopTemplate": "linux/rencal.desktop",
        "files": {
          "/usr/lib/renCal/providers": "providers",
          "/usr/bin/rencal-notifierd": "target/release/rencal-notifierd",
          "/usr/lib/systemd/user/rencal-notifierd.service": "notifierd/rencal-notifierd.service",
          "/usr/share/icons/hicolor/scalable/apps/rencal.svg": "icons/linux/icon.svg"
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["rencal"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNjMxMDEwOTE5RTk1MzYKUldRMmxaNlJFQkJqMjh6dDRyUzBRTDU4dnlMQlJjb0xtbGJ0ZG9hcnpWWDBNayszV0hHdGdiak0K",
      "endpoints": ["https://github.com/t4t5/rencal/releases/latest/download/latest.json"]
    }
  }
}
