        },
        "font.body": {
          "$ref": "#/$defs/Fonts"
        },
        "font.button": {
          "$ref": "#/$defs/Fonts"
        },
        "font.heading": {
          "$ref": "#/$defs/Fonts"
        },
        "font.mono": {
          "$ref": "#/$defs/Fonts"
        },
        "font.numerical": {
          "$ref": "#/$defs/Fonts"
        },
        "ghost_element.hover": {
