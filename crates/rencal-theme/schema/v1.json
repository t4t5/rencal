        },
        "control.leading_size": {
          "$ref": "#/$defs/Px"
        },
        "control.padding_x": {
          "$ref": "#/$defs/Px"
        },
        "control.row_gap": {
          "$ref": "#/$defs/Px"
        },
        "control.trailing_inset": {
          "$ref": "#/$defs/Px"
        },
        "element.background": {
          "$ref": "#/$defs/Color"
        },
        "element.highlight": {
          "$ref": "#/$defs/Color"
        },
        "element.highlight.text": {
          "$ref": "#/$defs/Color"
        },
        "element.highlight.text.muted": {
          "$ref": "#/$defs/Color"
        },
        "element.hover": {
          "$ref": "#/$defs/Color"
        },
        "element.muted": {
          "$ref": "#/$defs/Color"
        },
        "element.selected": {
          "$ref": "#/$defs/Color"
        },
        "element.selected.text": {
          "$ref": "#/$defs/Color"
        },
        "element.selected.text.muted": {
          "$ref": "#/$defs/Color"
        },
        "element.text": {
          "$ref": "#/$defs/Color"
        },
        "element.text.muted": {
          "$ref": "#/$defs/Color"
        },
        "elevated_surface.background": {
          "$ref": "#/$defs/Color"
        },
        "elevated_surface.text": {
          "$ref": "#/$defs/Color"
        },
