      "type": "object"
    },
    "TextShadow": {
      "anyOf": [
        {
          "properties": {
            "color": {
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": ["color"],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ThemeContent": {
      "description": "One variant of a family.",
      "properties": {
        "appearance": {
          "$ref": "#/$defs/Appearance"
        },
        "name": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/Style",
          "default": {}
        }
      },
      "required": ["name", "appearance"],
      "type": "object"
    },
    "Transform": {
      "anyOf": [
        {
          "enum": ["none", "uppercase"]
        },
        {
          "type": "null"
        }
      ]
    },
    "Weight": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$id": "https://rencal.org/schema/themes/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One theme file.",
  "properties": {
    "$schema": {
      "type": ["string", "null"]
    },
    "author": {
      "type": ["string", "null"]
    },
    "name": {
      "type": "string"
    },
    "themes": {
      "items": {
        "$ref": "#/$defs/ThemeContent"
      },
      "type": "array"
    }
  },
  "required": ["name", "themes"],
  "title": "renCal theme family",
  "type": "object"
}
