        },
        "brand": {
          "$ref": "#/$defs/Color"
        },
        "brand.hover": {
          "$ref": "#/$defs/Color"
        },
        "brand.text": {
          "$ref": "#/$defs/Color"
        },
        "button.border": {
          "$ref": "#/$defs/Color"
        },
        "control.active.background": {
          "$ref": "#/$defs/Color"
        },
        "control.active.border": {
          "$ref": "#/$defs/Color"
        },
        "control.gap": {
          "$ref": "#/$defs/Px"
        },
        "control.height": {
          "$ref": "#/$defs/Px"
        },
        "control.height.lg": {
          "$ref": "#/$defs/Px"
        },
        "control.height.sm": {
          "$ref": "#/$defs/Px"
        },
        "control.height.xs": {
