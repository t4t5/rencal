        },
        "surface.background": {
          "$ref": "#/$defs/Color"
        },
        "surface.text": {
          "$ref": "#/$defs/Color"
        },
        "surface.text.muted": {
          "$ref": "#/$defs/Color"
        },
        "surface.tint": {
