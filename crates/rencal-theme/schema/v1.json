{
  "$defs": {
    "Appearance": {
      "enum": ["light", "dark"],
      "type": "string"
    },
    "BorderStyle": {
      "anyOf": [
        {
          "enum": [
            "solid",
            "bevel_raised",
            "bevel_sunken",
            "bevel_raised_double",
            "bevel_sunken_double"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "Color": {
      "anyOf": [
        {
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "Fill": {
      "anyOf": [
        {
          "anyOf": [
            {
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            {
              "properties": {
                "gradient": {
                  "properties": {
                    "angle": {
                      "type": "number"
                    },
                    "from": {
                      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                      "type": "string"
                    },
                    "to": {
                      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                      "type": "string"
                    }
                  },
                  "required": ["from", "to"],
                  "type": "object"
                }
              },
              "required": ["gradient"],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "Fonts": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "Font families, first available wins."
        },
        {
          "type": "null"
        }
      ]
    },
    "Fraction": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "Px": {
      "anyOf": [
        {
          "description": "Pixels.",
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "Shadows": {
      "anyOf": [
        {
          "items": {
            "properties": {
              "blur": {
                "type": "number"
              },
              "color": {
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "type": "string"
              },
              "inset": {
                "type": "boolean"
              },
              "spread": {
                "type": "number"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": ["color"],
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "Style": {
      "additionalProperties": false,
      "description": "Flat dotted token keys. Unset or null tokens are derived.",
      "patternProperties": {
        "^(button|button\\.primary|control|popover|dialog|dialog\\.title_bar|toast|tabs\\.list|tabs\\.tab|toolbar\\.main|toolbar\\.sidebar|event\\.timed|event\\.all_day|month\\.day|minical\\.day|agenda\\.row|scrollbar|week_grid)(\\.(hover|active|selected|open|today|disabled))?\\.border$": {
          "$ref": "#/$defs/Color"
        },
        "^(button|button\\.primary|control|popover|dialog|dialog\\.title_bar|toast|tabs\\.list|tabs\\.tab|toolbar\\.main|toolbar\\.sidebar|event\\.timed|event\\.all_day|month\\.day|minical\\.day|agenda\\.row|scrollbar|week_grid)(\\.(hover|active|selected|open|today|disabled))?\\.border_style$": {
          "$ref": "#/$defs/BorderStyle"
        },
        "^(button|button\\.primary|control|popover|dialog|dialog\\.title_bar|toast|tabs\\.list|tabs\\.tab|toolbar\\.main|toolbar\\.sidebar|event\\.timed|event\\.all_day|month\\.day|minical\\.day|agenda\\.row|scrollbar|week_grid)(\\.(hover|active|selected|open|today|disabled))?\\.border_width$": {
          "$ref": "#/$defs/Px"
        },
        "^(button|button\\.primary|control|popover|dialog|dialog\\.title_bar|toast|tabs\\.list|tabs\\.tab|toolbar\\.main|toolbar\\.sidebar|event\\.timed|event\\.all_day|month\\.day|minical\\.day|agenda\\.row|scrollbar|week_grid)(\\.(hover|active|selected|open|today|disabled))?\\.fill$": {
          "$ref": "#/$defs/Fill"
        },
        "^(button|button\\.primary|control|popover|dialog|dialog\\.title_bar|toast|tabs\\.list|tabs\\.tab|toolbar\\.main|toolbar\\.sidebar|event\\.timed|event\\.all_day|month\\.day|minical\\.day|agenda\\.row|scrollbar|week_grid)(\\.(hover|active|selected|open|today|disabled))?\\.gap$": {
          "$ref": "#/$defs/Px"
        },
        "^(button|button\\.primary|control|popover|dialog|dialog\\.title_bar|toast|tabs\\.list|tabs\\.tab|toolbar\\.main|toolbar\\.sidebar|event\\.timed|event\\.all_day|month\\.day|minical\\.day|agenda\\.row|scrollbar|week_grid)(\\.(hover|active|selected|open|today|disabled))?\\.radius$": {
          "$ref": "#/$defs/Px"
        },
        "^(button|button\\.primary|control|popover|dialog|dialog\\.title_bar|toast|tabs\\.list|tabs\\.tab|toolbar\\.main|toolbar\\.sidebar|event\\.timed|event\\.all_day|month\\.day|minical\\.day|agenda\\.row|scrollbar|week_grid)(\\.(hover|active|selected|open|today|disabled))?\\.shadow$": {
          "$ref": "#/$defs/Shadows"
        },
        "^(button|button\\.primary|control|popover|dialog|dialog\\.title_bar|toast|tabs\\.list|tabs\\.tab|toolbar\\.main|toolbar\\.sidebar|event\\.timed|event\\.all_day|month\\.day|minical\\.day|agenda\\.row|scrollbar|week_grid)(\\.(hover|active|selected|open|today|disabled))?\\.text$": {
          "$ref": "#/$defs/Color"
        },
        "^(button|button\\.primary|control|popover|dialog|dialog\\.title_bar|toast|tabs\\.list|tabs\\.tab|toolbar\\.main|toolbar\\.sidebar|event\\.timed|event\\.all_day|month\\.day|minical\\.day|agenda\\.row|scrollbar|week_grid)(\\.(hover|active|selected|open|today|disabled))?\\.text_shadow$": {
          "$ref": "#/$defs/TextShadow"
        }
      },
      "properties": {
        "background": {
          "$ref": "#/$defs/Color"
        },
        "bevel.dark": {
          "$ref": "#/$defs/Color"
        },
        "bevel.highlight": {
