{
  "$schema": "https://rencal.org/schema/themes/v1.json",
  "name": "Ren",
  "author": "renCal",
  "themes": [
    {
      "name": "Ren",
      "appearance": "dark",
      "style": {
        "background": "#131313ff",
        "border.focused": "#71717bff",
        "brand": "#ff610bff",
        "control.gap": 8,
        "control.height": 34,
        "control.leading_size": 16,
        "control.padding_x": 8,
        "control.row_gap": 4,
        "error": "#e25252ff",
        "event.padding_x": 4,
        "font.body": [
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "font.mono": ["Geist Mono", "ui-monospace", "monospace"],
        "layout.padding": 12,
        "month.padding_x": 4,
        "primary": "#f56313ff",
        "radius": 0,
        "success": "#4caf50ff",
        "surface.tint_step": 0.05,
        "text": "#ffffffff",
        "text.scale.2xl.line_height": 32,
        "text.scale.2xl.size": 24,
        "text.scale.2xs.line_height": 14,
        "text.scale.2xs.size": 11,
        "text.scale.base.line_height": 24,
        "text.scale.base.size": 16,
        "text.scale.lg.line_height": 28,
        "text.scale.lg.size": 18,
        "text.scale.sm.line_height": 20,
        "text.scale.sm.size": 14,
        "text.scale.xl.line_height": 28,
        "text.scale.xl.size": 20,
        "text.scale.xs.line_height": 16,
        "text.scale.xs.size": 12,
        "today": "#3a93ffff",
        "typography.button.transform": "uppercase",
        "typography.heading.transform": "uppercase",
        "typography.numerical.transform": "uppercase",
        "warning": "#fd8742ff"
      }
    },
    {
      "name": "Ren Light",
      "appearance": "light",
      "style": {
        "background": "#fafafaff",
        "border.focused": "#71717bff",
        "brand": "#e2530aff",
        "control.gap": 8,
        "control.height": 34,
        "control.leading_size": 16,
        "control.padding_x": 8,
        "control.row_gap": 4,
        "error": "#d32f2fff",
        "event.padding_x": 4,
        "font.body": [
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "font.mono": ["Geist Mono", "ui-monospace", "monospace"],
        "layout.padding": 12,
        "month.padding_x": 4,
        "primary": "#e2530aff",
        "radius": 0,
        "success": "#2e7d32ff",
        "surface.tint_step": 0.04,
        "text": "#131313ff",
        "text.muted": "#1313138c",
        "text.scale.2xl.line_height": 32,
        "text.scale.2xl.size": 24,
        "text.scale.2xs.line_height": 14,
        "text.scale.2xs.size": 11,
        "text.scale.base.line_height": 24,
        "text.scale.base.size": 16,
        "text.scale.lg.line_height": 28,
        "text.scale.lg.size": 18,
        "text.scale.sm.line_height": 20,
        "text.scale.sm.size": 14,
        "text.scale.xl.line_height": 28,
        "text.scale.xl.size": 20,
        "text.scale.xs.line_height": 16,
        "text.scale.xs.size": 12,
        "today": "#1f75e0ff",
        "typography.button.transform": "uppercase",
        "typography.heading.transform": "uppercase",
        "typography.numerical.transform": "uppercase",
        "warning": "#c2410cff"
      }
    }
  ]
}
