---
// A static recreation of the renCal window, built from the same slots, class
// recipes and theme tokens as the app (src/components in the app). It renders
// at a fixed logical size and scales to fit its container, so it looks like a
// screenshot at any width. The landing page animates it with ./demo.ts.
import "../../styles/app-scope.css"
import "../../styles/app-window.css"

import AgendaDay from "./AgendaDay.astro"
import ComposeBox from "./ComposeBox.astro"
import EventForm from "./EventForm.astro"
import Icon from "./Icon.astro"
import Minical from "./Minical.astro"
import {
  AGENDA_END,
  AGENDA_START,
  CALENDARS,
  DEFAULT_CALENDAR,
  MONTH_START,
  TODAY,
  addDays,
  dayOfMonth,
  dayRange,
  eventsOn,
  isWeekend,
  monthName,
  type DemoEvent,
} from "./data"
import { REN_VARS, styleOf } from "./themes"

interface Props {
  id?: string
  class?: string
  /** Accessible description of the window, announced as an image. */
  label: string
  /** Logical window size in CSS px, before scaling. */
  width?: number
  height?: number
  activeDate?: string
  /** Below xl, show only the sidebar at its natural size instead of scaling
   * the whole window down. */
  sidebarWhenNarrow?: boolean
}

const {
  id,
  class: className,
  label,
  width = 1440,
  height = 750,
  activeDate = TODAY,
  sidebarWhenNarrow = false,
} = Astro.props

const renVars = styleOf(REN_VARS)

const SIDEBAR_WIDTH = 300
// Month cells are square, like the app's Grid (row height tracks column width).
const rowHeight = Math.round((width - SIDEBAR_WIDTH) / 7)

const weekStarts = (count: number) =>
  Array.from({ length: count }, (_, i) => addDays(MONTH_START, i * 7))
const weekOf = (start: string) => dayRange(start, addDays(start, 6))
const eventStyle = (event: DemoEvent | { calendar: keyof typeof CALENDARS }) =>
  `--calendar-event-color: var(--event-color, ${CALENDARS[event.calendar].color})`
const createdAttr = (event: DemoEvent) =>
  event.created ? { "data-created": "", hidden: true } : {}

const weekdayLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

// Agenda: days with events, plus ghost sections the demo lands on (empty days
// only show while active).
const GHOST_DAYS = ["2026-06-10", "2026-06-24"]
const agendaDays = dayRange(AGENDA_START, AGENDA_END).filter(
  (key) => key >= activeDate && (eventsOn(key).length > 0 || GHOST_DAYS.includes(key)),
)

// Month view: five weeks; the fifth only peeks in below the fold.
const monthWeeks = weekStarts(5).map(weekOf)
---

<div
  role="img"
  aria-label={label}
  data-sidebar-when-narrow={sidebarWhenNarrow || undefined}
  class:list={["rc-window-frame relative overflow-hidden", className]}
  style={`--rc-window-width: ${width}px; --rc-window-height: ${height}px; --rc-window-ratio: ${width} / ${height}`}
>
  <div
    id={id}
    data-app-window
    data-active-date={activeDate}
    aria-hidden="true"
    class="rc-scope rc-window absolute top-0 left-0 flex overflow-clip bg-(--background) select-none"
    style={renVars}
  >
    <!-- Sidebar -->
    <div
      data-slot="sidebar"
      class="flex w-[300px] shrink-0 flex-col overflow-hidden border-r bg-(--sidebar)"
    >
      <ComposeBox />

      <!-- Minical -->
      <Minical activeDate={activeDate} />

      <!-- Agenda -->
      <div class="flex min-h-0 grow flex-col overflow-hidden bg-(--sidebar)">
        <div data-agenda-scroll class="min-h-0 grow overflow-hidden">
          {agendaDays.map((key) => <AgendaDay date={key} activeDate={activeDate} />)}
        </div>
      </div>
    </div>

    <!-- Main -->
    <div data-slot="main" class="flex min-w-0 grow flex-col">
      <div class="flex shrink-0 gap-2 p-(--layout-padding)">
        <div class="flex items-center gap-2">
          <span
            data-typography="button"
            class="inline-flex h-(--control-height) items-center justify-center rounded-(--radius-md) bg-(--secondary) px-3 font-medium text-(--secondary-foreground)"
            >Today</span
          >
          <span
            class="flex size-(--control-height) items-center justify-center rounded-(--radius-md)"
          >
            <Icon name="settings" class="size-4" />
          </span>
          <span
            class="flex size-(--control-height) items-center justify-center rounded-(--radius-md)"
          >
            <Icon name="cloudCheck" class="size-5 text-(--muted-foreground)" />
          </span>
        </div>
        <div class="grow"></div>
        <span
          data-typography="button"
          class="inline-flex h-(--control-height) min-w-24 items-center justify-between gap-2 rounded-(--radius-md) bg-(--secondary) px-3 font-medium text-(--secondary-foreground)"
        >
          Month
          <span data-slot="select-icon" class="text-(--muted-foreground)">
            <Icon name="chevronDown" class="size-3" />
          </span>
        </span>
        <span
          class="flex size-(--control-height) items-center justify-center rounded-(--radius-md) bg-(--secondary) text-(--secondary-foreground)"
        >
          <Icon name="search" class="size-4" />
        </span>
      </div>

      <div class="grid grid-cols-7 border-b">
        {
          weekdayLabels.map((label, i) => (
            <div
              data-typography="numerical"
              class:list={[
                "rc-text-2xs py-2 text-center font-medium text-(--muted-foreground) uppercase in-data-drafting:opacity-50",
                i >= 5 && "bg-(--weekend)",
              ]}
            >
              {label}
            </div>
          ))
        }
      </div>

      <div class="relative min-h-0 grow overflow-hidden">
        {
          monthWeeks.map((week, weekIndex) => {
            const monthStartCol = week.findIndex((key) => dayOfMonth(key) === 1)
            const allDay = week.flatMap((key, col) =>
              eventsOn(key)
                .filter((event) => !event.start)
                .map((event) => ({ event, col })),
            )
            // The weekday header's border already marks a month starting on the first row.
            const boundary =
              monthStartCol === 0 && weekIndex > 0 ? (
                <div
                  data-slot="month-boundary"
                  class="pointer-events-none absolute -top-px right-0 left-0 z-20 h-[3px]"
                />
              ) : monthStartCol > 0 ? (
                <div
                  data-slot="month-boundary"
                  class="pointer-events-none absolute top-0 bottom-0 z-20 w-0.5 -translate-x-px"
                  style={`left: ${(monthStartCol / 7) * 100}%`}
                />
              ) : null
            const bodyBoundary = monthStartCol > 0 ? boundary : null
            const inset = (col: number) => `calc(${(col / 7) * 100}% + var(--month-padding-inline))`
            const barStyle = (col: number) =>
              `top: 0; height: calc(var(--lane-height) - 3px); left: ${inset(col)}; right: ${inset(6 - col)}`
            const spacer = (
              <div class="pointer-events-none h-[calc(var(--lane-height)-3px)] shrink-0" />
            )
            return (
              <div
                data-slot="month-week"
                class="flex flex-col border-b"
                style={`height: ${rowHeight}px`}
              >
                <div class="relative grid grid-cols-7">
                  {boundary}
                  {week.map((key) => (
                    <div
                      data-slot="month-day-header"
                      data-date-key={key}
                      data-typography="numerical"
                      data-selected={key === activeDate || undefined}
                      class:list={[
                        "flex items-center justify-end gap-1 border-r p-1 last:border-r-0",
                        isWeekend(key) && "bg-(--weekend)",
                        "data-selected:bg-(--selected) data-selected:text-(--selected-foreground)",
                      ]}
                    >
                      <span
                        class:list={[
                          "text-xs text-(--muted-foreground)",
                          dayOfMonth(key) !== 1 && "hidden in-data-selected:inline",
                        ]}
                      >
                        {monthName(key)}
                      </span>
                      <span
                        data-slot="month-day-number"
                        class:list={[
                          "flex h-5 w-5 items-center justify-center text-xs in-data-drafting:opacity-50",
                          key === TODAY
                            ? "rounded-(--radius-circle) bg-(--today) text-(--today-foreground)"
                            : "in-data-selected:rounded-(--radius-circle) in-data-selected:bg-(--selected)",
                        ]}
                      >
                        {dayOfMonth(key)}
                      </span>
                    </div>
                  ))}
                </div>

                <div class="relative grid min-h-0 grow grid-cols-7">
                  {bodyBoundary}
                  {allDay.map(({ event, col }) => (
                    <div
                      data-slot="calendar-event"
                      data-view="month"
                      data-kind="all-day"
                      class="absolute truncate rounded-(--radius-xs) px-(--event-padding-inline) py-px text-xs"
                      style={`${barStyle(col)}; ${eventStyle(event)}`}
                    >
                      <span>{event.title}</span>
                    </div>
                  ))}
                  {week.includes("2026-06-27") && (
                    <div
                      data-slot="calendar-event"
                      data-view="month"
                      data-kind="all-day"
                      data-draft
                      data-draft-bar="2026-06-27"
                      hidden
                      class="absolute truncate rounded-(--radius-xs) px-(--event-padding-inline) py-px text-xs"
                      style={`${barStyle(5)}; ${eventStyle({ calendar: DEFAULT_CALENDAR })}`}
                    >
                      <span data-draft-title />
                    </div>
                  )}
                  {week.map((key) => {
                    const timed = eventsOn(key).filter((event) => event.start)
                    const hasAllDay = allDay.some(({ event }) => event.date === key)
                    return (
                      <div
                        data-slot="month-day"
                        data-date-key={key}
                        data-selected={key === activeDate || undefined}
                        class:list={[
                          "flex min-h-0 flex-col gap-1 overflow-hidden px-(--month-padding-inline) pb-1 shadow-[inset_-1px_0_var(--border)] last:shadow-none",
                          isWeekend(key) && "bg-(--weekend)",
                          "data-selected:bg-(--selected) data-selected:text-(--selected-foreground)",
                        ]}
                      >
                        {hasAllDay && spacer}
                        {key === "2026-06-27" && (
                          <div data-draft-spacer="2026-06-27" hidden>
                            {spacer}
                          </div>
                        )}
                        {(key === "2026-06-25" || key === "2026-06-27") && (
                          <div
                            data-slot="calendar-event"
                            data-view="month"
                            data-kind="timed"
                            data-draft
                            data-draft-chip={key}
                            hidden
                            class="flex shrink-0 items-center gap-(--event-padding-inline) truncate rounded-(--radius-xs) pr-(--event-padding-inline) text-xs"
                            style={eventStyle({ calendar: DEFAULT_CALENDAR })}
                          >
                            <div
                              data-slot="calendar-event-color-marker"
                              class="h-full w-0.5 shrink-0"
                            />
                            <span class="truncate">
                              <span
                                data-slot="calendar-event-time"
                                data-typography="numerical"
                                data-draft-time
                                class="rc-text-2xs"
                              />{" "}
                              <span data-draft-title />
                            </span>
                          </div>
                        )}
                        {timed.map((event) => (
                          <div
                            data-slot="calendar-event"
                            data-view="month"
                            data-kind="timed"
                            data-event-id={event.id}
                            class="flex shrink-0 items-center gap-(--event-padding-inline) truncate rounded-(--radius-xs) pr-(--event-padding-inline) text-xs"
                            style={eventStyle(event)}
                            {...createdAttr(event)}
                          >
                            <div
                              data-slot="calendar-event-color-marker"
                              class="h-full w-0.5 shrink-0"
                            />
                            <span class="truncate">
                              <span
                                data-slot="calendar-event-time"
                                data-typography="numerical"
                                class="rc-text-2xs"
                                set:text={event.start}
                              />{" "}
                              <span data-slot="calendar-event-title">{event.title}</span>
                            </span>
                          </div>
                        ))}
                      </div>
                    )
                  })}
                </div>
              </div>
            )
          })
        }
      </div>
    </div>

    <!-- Event popover (positioned like the app's, beside the agenda) -->
    <div
      data-event-popover
      hidden
      class="rc-popover absolute top-[122px] left-[307px] z-50 max-h-[80%] w-[350px] origin-left overflow-hidden rounded-(--radius-md) border bg-(--popover) text-(--popover-foreground) shadow-2xl"
    >
      <EventForm variant="popover" />
    </div>
  </div>
</div>
