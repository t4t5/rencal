---
import OmarchyLogo from "../../icons/omarchy.astro"
import LinuxLogo from "../../icons/linux.astro"
import AppleLogo from "../../icons/apple.astro"
import WindowsLogo from "../../icons/windows.astro"
import { site } from "../../site"
import AppWindow from "../app-window/AppWindow.astro"
import Button from "../Button.astro"
---

<div class="text-center flex flex-col items-center gap-7 border-b border-b-separator px-4">
  <h1 class="uppercase text-[30px] md:text-[40px] leading-tight pt-10 md:pt-6 text-pretty">
    {site.tagline}
  </h1>

  <p class="max-w-xl text-balance text-[17px]">
    <span class="inline-block max-w-full">A free, open-source desktop calendar.</span>{" "}<span
      class="inline-block max-w-full">Works with Google, iCloud, Outlook and CalDAV.</span
    >
  </p>

  <div id="linux-availability" class="flex gap-3 items-center">
    <OmarchyLogo class="h-4" />
    <LinuxLogo class="h-4" />
    <p>
      Built for <a href="/omarchy/" class="underline hover:text-foreground">Omarchy</a> + Linux
    </p>
  </div>

  <div class="flex gap-5">
    <Button href="/download/" variant="primary">Download</Button>
    <Button href="/docs/installation/">Docs</Button>
  </div>

  <div id="platform-availability" class="hidden gap-3 items-center">
    <AppleLogo class="h-4" />
    <WindowsLogo class="h-4" />
    <LinuxLogo class="h-4" />
    <p>Available for macOS + Linux</p>
  </div>

  <div
    class="relative mt-8 w-[calc(100%+1rem)] self-start overflow-hidden border border-separator border-b-0 border-r-0 md:mx-0 md:w-full md:max-w-5xl md:self-auto md:border-x"
  >
    <AppWindow
      id="hero-demo"
      label="renCal, an open-source calendar app for Omarchy Linux, showing a month of events"
      activeDate="2026-06-10"
      class="w-[180vw] max-w-none rounded-none md:w-full"
    />
  </div>
</div>

<script>
  import { playDemo } from "../app-window/demo"

  const demo = document.querySelector<HTMLElement>("#hero-demo")
  if (demo) playDemo(demo)

  const linuxAvailability = document.querySelector("#linux-availability")
  const platformAvailability = document.querySelector("#platform-availability")
  const userAgent = navigator.userAgent.toLowerCase()
  const isMacOs = userAgent.includes("macintosh")
  const isWindows = userAgent.includes("windows")

  if (isMacOs || isWindows) {
    linuxAvailability?.classList.add("hidden")
    platformAvailability?.classList.replace("hidden", "flex")
  }
</script>
