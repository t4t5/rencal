---
import "../../styles/features.css"

import BarWidget from "./features/BarWidget.astro"
import BentoCard from "./features/BentoCard.astro"
import CaldirDesktop from "./features/CaldirDesktop.astro"
import ComposeCloseup from "./features/ComposeCloseup.astro"
import DetailsGrid from "./features/DetailsGrid.astro"
import FeatureSection from "./features/FeatureSection.astro"
import KeyboardCard from "./features/KeyboardCard.astro"
import PaletteCloseup from "./features/PaletteCloseup.astro"
import ProviderTiles from "./features/ProviderTiles.astro"
import ScenePlayer from "./features/ScenePlayer.astro"
import ThemeShowcase from "./features/ThemeShowcase.astro"
---

<div class="px-6 py-10 md:px-10 md:py-16">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-28 md:gap-40">
    <FeatureSection
      title="Your calendar is a folder"
      description="Every event is a plaintext .ics file on your machine. Script it, or give it to an agent. No MCP server needed."
    >
      <CaldirDesktop />
    </FeatureSection>

    <FeatureSection
      title="Built for power users"
      description="Navigate and get things done with just the keyboard."
    >
      <div class="feature-panes grid lg:grid-cols-6">
        <BentoCard
          class="lg:col-span-4"
          title="Natural input"
          description="Type events the way you say them: “lunch with Sarah tomorrow at 1” or “team sync every Monday”."
        >
          <div data-scene-stage class="relative sm:h-96">
            <!-- Fades late so the form's Repeat row stays visible. -->
            <div class="pt-9 pl-6 mask-b-from-85% sm:absolute sm:inset-0 sm:p-0">
              <!-- Narrow cards scale it down so the longest typed line fits. -->
              <div
                class="feature-ui w-[min(600px,calc(100%*600/400))] sm:absolute sm:top-9 sm:left-1/2 sm:w-[600px] sm:-translate-x-1/2"
              >
                <ComposeCloseup />
              </div>
            </div>
          </div>
        </BentoCard>
        <BentoCard
          class="lg:col-span-2"
          title="Keyboard-first"
          description="Vim-style navigation, and a shortcut for everything else."
        >
          <KeyboardCard />
        </BentoCard>
        <BentoCard
          class="lg:col-span-2"
          title="Syncs with any provider"
          description="Google, iCloud, Outlook and CalDAV, plus a growing set of provider plugins."
        >
          <ProviderTiles />
        </BentoCard>
        <BentoCard
          class="lg:col-span-2"
          title="In your bar"
          description="See your next meeting in the Omarchy bar and join it in one click."
          link={{ href: "/docs/omarchy-widget/", label: "Get the widget" }}
        >
          <BarWidget />
        </BentoCard>
        <BentoCard
          class="lg:col-span-2"
          title="Command palette"
          description="Every action a keystroke away."
        >
          <PaletteCloseup />
        </BentoCard>
      </div>
    </FeatureSection>

    <FeatureSection
      title="Infinitely customizable"
      description="Install any community theme or bring your own CSS."
      link={{ href: "/themes/", label: "Learn more" }}
    >
      <ThemeShowcase />
    </FeatureSection>

    <DetailsGrid />
  </div>
</div>

<ScenePlayer />
