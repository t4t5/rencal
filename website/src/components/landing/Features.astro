---
import AgentCloseup from "./features/AgentCloseup.astro"
import ComposeCloseup from "./features/ComposeCloseup.astro"
import FeatureSection, { type Feature } from "./features/FeatureSection.astro"
import FilesCloseup from "./features/FilesCloseup.astro"
import KeyboardCloseup from "./features/KeyboardCloseup.astro"
import ProvidersCloseup from "./features/ProvidersCloseup.astro"
import ThemesCloseup from "./features/ThemesCloseup.astro"

const dataFeatures: Feature[] = [
  {
    id: "files",
    title: "Plain files",
    description:
      "Every event is stored as an .ics file on your machine. It works offline, is human-readable, and can easily be backed up.",
  },
  {
    id: "providers",
    title: "Syncs with any provider",
    description:
      "Connect to Google Calendar, iCloud, Outlook, and CalDAV servers through a growing ecosystem of provider plugins.",
  },
  {
    id: "agents",
    title: "Agent-friendly",
    description:
      "Your calendar is just a directory. Use grep, shell scripts, git, or the caldir CLI. No complex MCP servers needed.",
  },
]

const speedFeatures: Feature[] = [
  {
    id: "compose",
    title: "Natural input",
    description:
      'Type events the way you say them: "lunch with Sarah tomorrow at 1" or "team sync every Monday".',
  },
  {
    id: "keyboard",
    title: "Keyboard-first",
    description: "Move around with Vim-style navigation and shortcuts built for power users.",
  },
  {
    id: "themes",
    title: "Omarchy native",
    description:
      "Built for Omarchy Linux, with themes that adapt to the color palette of your system.",
    link: { href: "/omarchy/", label: "Learn more" },
  },
]
---

<div class="flex flex-col gap-24 py-10 md:gap-32 md:py-16">
  <FeatureSection
    eyebrow="Local-first"
    title="Your calendar is just files"
    lead="Events live as plain .ics files on your machine, kept in sync with the calendars you already use."
    features={dataFeatures}
  >
    <FilesCloseup slot="files" />
    <ProvidersCloseup slot="providers" />
    <AgentCloseup slot="agents" />
  </FeatureSection>

  <FeatureSection
    eyebrow="Built for speed"
    title="Made for power users"
    lead="Type events the way you say them, get around without the mouse, and match the look of your desktop."
    features={speedFeatures}
    flip
  >
    <ComposeCloseup slot="compose" />
    <KeyboardCloseup slot="keyboard" />
    <ThemesCloseup slot="themes" />
  </FeatureSection>
</div>
