---
import { THEMES } from "../app-window/themes"
import AgentCloseup from "./features/AgentCloseup.astro"
import ComposeCloseup from "./features/ComposeCloseup.astro"
import FeatureRow from "./features/FeatureRow.astro"
import FilesCloseup from "./features/FilesCloseup.astro"
import KeyboardCloseup from "./features/KeyboardCloseup.astro"
import ProvidersCloseup from "./features/ProvidersCloseup.astro"
import ThemesCloseup from "./features/ThemesCloseup.astro"
import { THEME_WALLPAPERS, WALLPAPERS } from "./features/wallpapers"

// The themes close-up starts on ren, framed in its primary color.
const themeWallpapers = THEMES.map((theme) => ({
  key: theme.id,
  src: THEME_WALLPAPERS[theme.id],
  border: theme.vars["--primary"],
}))
---

<section class="px-6 py-10 md:px-10 md:py-16">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-16 md:gap-24">
    <FeatureRow
      title="Plain files"
      description="Every event is stored as an .ics file on your machine. It works offline, is human-readable, and can easily be backed up."
      wallpapers={[WALLPAPERS.windingRoad]}
    >
      <FilesCloseup />
    </FeatureRow>
    <FeatureRow
      title="Syncs with any provider"
      description="Connect to Google Calendar, iCloud, Outlook, and CalDAV servers through a growing ecosystem of provider plugins."
      wallpapers={[WALLPAPERS.mountainMoon]}
    >
      <ProvidersCloseup />
    </FeatureRow>
    <FeatureRow
      title="Agent-friendly"
      description="Your calendar is just a directory. Use grep, shell scripts, git, or the caldir CLI. No complex MCP servers needed."
      wallpapers={[WALLPAPERS.theJourney]}
    >
      <AgentCloseup />
    </FeatureRow>
    <FeatureRow
      title="Natural input"
      description='Type events the way you say them: "lunch with Sarah tomorrow at 1" or "team sync every Monday".'
      wallpapers={[WALLPAPERS.newHorizons]}
    >
      <ComposeCloseup />
    </FeatureRow>
    <FeatureRow
      title="Keyboard-first"
      description="Move around with Vim-style navigation and shortcuts built for power users."
      wallpapers={[WALLPAPERS.blackMoon]}
    >
      <KeyboardCloseup />
    </FeatureRow>
    <FeatureRow
      title="Omarchy native"
      description="Built for Omarchy Linux, with themes that adapt to the color palette of your system."
      link={{ href: "/omarchy/", label: "Learn more" }}
      wallpapers={themeWallpapers}
    >
      <ThemesCloseup />
    </FeatureRow>
  </div>
</section>
