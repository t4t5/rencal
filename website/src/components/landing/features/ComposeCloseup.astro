---
// The sidebar's compose box, zoomed in, parsing an event as it's typed. The
// "compose" scene types it; its final state is filled in on load.
import ComposeBox from "../../app-window/ComposeBox.astro"
import Closeup from "./Closeup.astro"
---

<Closeup
  label='Typing "Lunch with Sarah tomorrow at 1" into renCal, which fills in the date and time'
  width={330}
  height={330}
  class="bg-(--sidebar)"
  data-scene="compose"
  data-composing
  data-typing
>
  <ComposeBox open />
</Closeup>
