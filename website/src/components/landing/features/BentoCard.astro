---
// A card in a features grid: its visual on top, fading into the card, and a
// two-tone line of text below.
interface Props {
  title: string
  description: string
  link?: { href: string; label: string }
  /** Column span, e.g. `lg:col-span-4`. */
  class?: string
}

const { title, description, link, class: className } = Astro.props
---

<article class:list={["feature-card flex flex-col", className]}>
  <slot />

  <div class="mt-auto p-6 pt-2 text-[15px] leading-relaxed text-pretty">
    <h3 class="feature-title inline text-[15px] tracking-normal">{title}.</h3>
    <p class="inline">
      {description}
      {
        link && (
          <a href={link.href} class="whitespace-nowrap text-foreground hover:text-primary">
            {link.label} →
          </a>
        )
      }
    </p>
  </div>
</article>
