---
// A card in a features grid: its visual on top, fading into the card, and its
// title and description below.
interface Props {
  title: string
  description: string
  link?: { href: string; label: string }
  /** Column span, e.g. `lg:col-span-4`. */
  class?: string
}

const { title, description, link, class: className } = Astro.props
---

<article class:list={["feature-card flex flex-col", className]}>
  <slot />

  <div class="mt-auto flex flex-col gap-2 p-6 pt-2">
    <h3 class="feature-title text-[13px] tracking-[0.04em]">{title}</h3>
    <p class="text-[15px] leading-relaxed text-pretty">
      {description}
      {
        link && (
          <a href={link.href} class="whitespace-nowrap text-foreground hover:text-primary">
            {link.label} →
          </a>
        )
      }
    </p>
  </div>
</article>
