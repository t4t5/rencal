---
// A coding agent answering calendar questions with the caldir CLI.
import Terminal from "./Terminal.astro"
import type { TerminalLine } from "./terminal"

const THINK_MS = 900
const tool = (command: string): TerminalLine => ({
  output: [["● ", "success"], ["Bash", "bold"], `(${command})`],
  delay: THINK_MS,
})
const reply = (text: string): TerminalLine => ({
  output: [["● ", "muted"], text],
  delay: THINK_MS,
})

const lines: TerminalLine[] = [
  { input: "Am I free for lunch with Sarah on Friday?" },
  { output: [] },
  tool("caldir events --from 2026-06-26 --to 2026-06-26"),
  {
    output: [
      ["  ⎿  ", "muted"],
      ["Fri Jun 26", "bold"],
    ],
    delay: 400,
  },
  { output: ["       09:30 Product stand-up ", ["[google-work]", "muted"]] },
  { output: ["       19:00 Grocery delivery ", ["[icloud-personal]", "muted"]] },
  { output: [] },
  reply("Yes, you're free from 10:00 until 19:00."),
  { output: [] },
  { input: "Great, book it for 1pm" },
  { output: [] },
  tool('caldir new "Lunch with Sarah" --start "friday 1pm"'),
  { output: [] },
  reply("Done! Lunch with Sarah is on Friday at 13:00."),
]
---

<Terminal
  label="A coding agent using the caldir CLI to check a calendar and add a lunch event"
  lines={lines}
  prompt=">"
/>
