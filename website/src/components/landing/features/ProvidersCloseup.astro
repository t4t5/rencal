---
// The "Connect calendar" dialog (src/components/settings/accounts/AddAccountModal.tsx
// and ProviderList.tsx in the app), with a provider plugin (Proton) listed
// between the built-in providers and CalDAV, as the app orders them.
import Icon from "../../app-window/Icon.astro"
import type { IconName } from "../../app-window/icons"
import Closeup from "./Closeup.astro"

const PROVIDERS: { name: string; icon?: IconName }[] = [
  { name: "Google", icon: "google" },
  { name: "iCloud", icon: "apple" },
  { name: "Outlook", icon: "microsoft" },
  { name: "Proton", icon: "proton" },
  { name: "Other CalDAV server" },
]
---

<Closeup
  label="renCal's Connect calendar dialog, listing Google, iCloud, Outlook, Proton and other CalDAV servers"
  width={500}
  height={500}
  class="bg-(--background)"
  data-scene="providers"
>
  <div class="absolute inset-0 bg-black/40"></div>
  <div
    class="absolute top-6 left-6 grid w-[425px] gap-4 rounded-(--radius-lg) border bg-(--background) p-6 shadow-lg"
  >
    <div data-typography="heading" class="text-center text-base font-semibold text-(--foreground)">
      Connect calendar
    </div>

    <span class="absolute top-1 right-1 p-1 opacity-70">
      <Icon name="close" class="size-4" />
    </span>

    <div class="flex flex-col items-center gap-3">
      <div class="flex w-60 flex-col gap-3">
        {
          PROVIDERS.map((provider) => (
            <div
              data-provider
              data-typography="button"
              class="inline-flex h-(--control-height) items-center justify-center gap-3 rounded-(--radius-md) bg-(--secondary) px-3 font-medium text-(--secondary-foreground) transition-colors data-hover:bg-(--secondary-hover)"
            >
              {provider.icon && <Icon name={provider.icon} class="size-4" />}
              {provider.name}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Closeup>
