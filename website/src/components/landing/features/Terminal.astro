---
// A terminal session in the app's colors and mono font, filling its parent.
// Inputs are typed and outputs revealed by the "terminal" scene, which scrolls
// like a real terminal; without it, the whole session shows. The slot goes
// above the session, like a program's banner. Inputs wrap with a hanging
// indent, at `--term-wrap` when it's set.
import type { TerminalLine, Tone } from "./terminal"

interface Props {
  lines: TerminalLine[]
  prompt?: string
}

const { lines, prompt = "❯" } = Astro.props

const TONES: Record<Tone, string> = {
  muted: "text-(--muted-foreground)",
  success: "text-(--success)",
  bold: "font-bold",
}
---

<div
  data-scene="terminal"
  data-term-screen
  class="h-full overflow-hidden bg-(--background) px-5 pt-5 pb-3 font-mono text-[13px] leading-5"
>
  <slot />
  {
    lines.map((line) =>
      "input" in line ? (
        <div data-term-input={line.input} class="max-w-(--term-wrap) -indent-[2ch] pl-[2ch]">
          <span class="text-(--primary)">{prompt}</span> <span data-term-text>{line.input}</span>
        </div>
      ) : (
        <div
          data-term-output
          data-delay={line.delay}
          data-term-select={line.select}
          class="min-h-[1lh] *:whitespace-pre"
        >
          {line.output.map((segment) =>
            typeof segment === "string" ? (
              <span>{segment}</span>
            ) : (
              <span class={TONES[segment[1]]}>{segment[0]}</span>
            ),
          )}
        </div>
      ),
    )
  }
  <div data-term-idle class="mt-5">
    <span class="text-(--primary)">{prompt}</span>
    <span data-term-cursor class="inline-block h-[1lh] w-[1ch] bg-(--foreground)/70 align-top"
    ></span>
  </div>
</div>
