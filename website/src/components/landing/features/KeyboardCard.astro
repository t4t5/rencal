---
// Vim keys above the minical. The "keyboard" scene presses each key and moves
// the selected day with it.
import Minical from "../../app-window/Minical.astro"
import Closeup from "./Closeup.astro"

const KEYS = [
  { key: "h", hint: "←" },
  { key: "j", hint: "↓" },
  { key: "k", hint: "↑" },
  { key: "l", hint: "→" },
]
---

<div data-scene-stage class="feature-glow relative h-80">
  <div aria-hidden="true" class="flex justify-center gap-3 pt-9">
    {
      KEYS.map(({ key, hint }) => (
        <kbd data-keycap={key} class="keycap">
          <span class="keycap-hint">{hint}</span>
          <span class="keycap-letter">{key.toUpperCase()}</span>
        </kbd>
      ))
    }
  </div>

  <div class="feature-fade absolute inset-x-0 top-[140px] bottom-0 px-6">
    <div class="feature-ui mx-auto max-w-[300px]">
      <Closeup
        label="renCal's mini calendar, with the selected day moved by the H, J, K and L keys"
        width={340}
        height={290}
        class="bg-(--sidebar)"
        data-scene="keyboard"
      >
        <Minical activeDate="2026-07-02" />
      </Closeup>
    </div>
  </div>
</div>
