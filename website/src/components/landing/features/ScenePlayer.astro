---
// Plays the scene inside each `[data-scene-stage]` whenever the stage scrolls
// into view. Include once per page.
---

<script>
  import { SCENES, type Wait } from "./scenes"

  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches

  const sceneOf = (stage: HTMLElement) => {
    const name = stage.querySelector<HTMLElement>("[data-scene]")?.dataset.scene
    return name ? SCENES[name] : undefined
  }

  const stages = [...document.querySelectorAll<HTMLElement>("[data-scene-stage]")]
  const rest = () => stages.forEach((stage) => sceneOf(stage)?.rest?.(stage))
  rest()
  // Resting states measure text (the compose highlight), so redo them once fonts load.
  void document.fonts.ready.then(rest)

  // A scene is reset as its stage nears the viewport, so the visitor never sees
  // it jump back, and its timeline starts once the stage is in view.
  const NEAR = "50% 0px"
  const IN_VIEW = 0.4

  for (const stage of stages) {
    const scene = sceneOf(stage)
    if (reducedMotion || !scene) continue

    let run: AbortController | null = null
    let showStart = () => {}

    new IntersectionObserver(
      ([entry]) => {
        run?.abort()
        run = null
        if (!entry.isIntersecting) {
          scene.rest?.(stage)
          return
        }
        const controller = new AbortController()
        run = controller
        const shown = new Promise<void>((resolve) => (showStart = resolve))
        const wait: Wait = async (ms) => {
          await shown
          await delay(ms, controller.signal)
        }
        scene.play(stage, wait).catch(() => {})
      },
      { rootMargin: NEAR },
    ).observe(stage)

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) showStart()
      },
      { threshold: IN_VIEW },
    ).observe(stage)
  }

  function delay(ms: number, signal: AbortSignal) {
    return new Promise<void>((resolve, reject) => {
      if (signal.aborted) return reject(signal.reason)
      const timer = setTimeout(resolve, ms)
      signal.addEventListener(
        "abort",
        () => {
          clearTimeout(timer)
          reject(signal.reason)
        },
        { once: true },
      )
    })
  }
</script>
