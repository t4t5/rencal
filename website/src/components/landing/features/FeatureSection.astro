---
// A group of features: eyebrow, title and a short description, centered above
// the section's visual.
interface Props {
  eyebrow: string
  title: string
  description: string
  link?: { href: string; label: string }
}

const { eyebrow, title, description, link } = Astro.props
---

<section class="flex flex-col gap-12 md:gap-16">
  <header class="mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
    <p class="feature-eyebrow">{eyebrow}</p>
    <h2 class="feature-title text-[32px] leading-[1.1] text-balance md:text-[44px]">{title}</h2>
    <p class="max-w-xl text-[17px] text-balance md:text-lg">
      {description}
      {
        link && (
          <a href={link.href} class="whitespace-nowrap text-foreground hover:text-primary">
            {link.label} →
          </a>
        )
      }
    </p>
  </header>

  <slot />
</section>
