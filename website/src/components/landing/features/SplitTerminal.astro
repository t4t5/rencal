---
// Two terminal panes side by side, like a tmux split: the caldir directory
// on the left (static), a coding agent reading it on the right (typed out).
// Stacked on narrow screens, zoomed in to run off the right edge, with the
// static pane cut short.
import { AGENT_SESSION, FILES_SESSION } from "./sessions"
import Terminal from "./Terminal.astro"

const WIDTH = 560
const HEIGHT = 440
---

<div class="feature-card grid lg:grid-cols-2">
  <div class="flex min-w-0 flex-col max-lg:border-b lg:border-r border-white/10">
    <p class="pane-title">~/caldir</p>
    <div class="feature-fade overflow-hidden max-lg:aspect-[560/370]">
      <div class="max-lg:w-[140%]">
        <Terminal
          label="A terminal listing the ~/caldir directory, with one .ics file per event, and printing one of them"
          lines={FILES_SESSION}
          animate={false}
          width={WIDTH}
          height={HEIGHT}
        />
      </div>
    </div>
  </div>
  <div class="flex min-w-0 flex-col">
    <p class="pane-title">claude</p>
    <div data-scene-stage class="overflow-hidden max-lg:aspect-[560/490]">
      <div class="max-lg:w-[140%]">
        <Terminal
          label="A coding agent listing flight events in the caldir directory to count the days spent abroad in each country"
          lines={AGENT_SESSION}
          prompt=">"
          width={WIDTH}
          height={HEIGHT}
        />
      </div>
    </div>
  </div>
</div>

<style>
  .pane-title {
    padding: 8px 20px;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.025);
    font-family: var(--heading-font-family);
    font-size: 12px;
    color: color-mix(in srgb, var(--color-muted) 60%, transparent);
  }
</style>
