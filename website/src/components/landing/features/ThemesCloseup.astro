---
// A crop of the app window: the sidebar and the start of the month view.
// ThemeShowcase swaps its theme.
import AppWindow from "../../app-window/AppWindow.astro"

const WINDOW_WIDTH = 1440
// Crop origin and width, in the window's logical px.
const CROP = { x: 0, y: 0, width: 300 + 5 * ((WINDOW_WIDTH - 300) / 7) }
---

<div class="overflow-hidden">
  <div
    style={`width: calc(100% * ${WINDOW_WIDTH} / ${CROP.width}); margin-left: calc(-100% * ${CROP.x} / ${CROP.width}); margin-top: calc(-100% * ${CROP.y} / ${CROP.width})`}
  >
    <AppWindow label="renCal's month view in the selected theme" width={WINDOW_WIDTH} />
  </div>
</div>
