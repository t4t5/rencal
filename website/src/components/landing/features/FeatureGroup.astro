---
// A heading over a run of FeatureRows.
interface Props {
  eyebrow: string
  title: string
  lead: string
}

const { eyebrow, title, lead } = Astro.props
---

<section class="px-6 md:px-10">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-16 md:gap-24">
    <header class="flex max-w-xl flex-col gap-4">
      <p class="font-[family-name:var(--heading-font-family)] text-sm text-primary uppercase">
        {eyebrow}
      </p>
      <h2 class="text-2xl leading-tight text-pretty md:text-3xl">{title}</h2>
      <p class="text-[17px] text-pretty">{lead}</p>
    </header>
    <slot />
  </div>
</section>
