---
import "../../styles/features.css"

import GitHubLogo from "../../icons/github.astro"
import { site } from "../../site"
---

<div class="px-8 flex flex-col items-center gap-5 md:gap-8 text-center">
  <h2 class="feature-title text-[28px] leading-[1.15] text-pretty md:text-[36px]">
    Free and open-source
  </h2>

  <p class="text-balance text-[17px] md:text-lg">
    No subscriptions. No enshittification. Built in the open.
  </p>

  <div class="flex gap-5">
    <a href="/download/">
      <button class="primary">Download</button>
    </a>

    <a href={site.repoUrl} target="_blank">
      <button class="flex items-center gap-2">
        <GitHubLogo class="w-5" />
        <span>Contribute</span>
      </button>
    </a>
  </div>
</div>
