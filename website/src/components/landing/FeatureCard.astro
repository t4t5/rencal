---
interface Props {
  title: string
  description: string
  link?: { href: string; label: string }
}

const { title, description, link } = Astro.props
---

<div class="flex flex-col gap-3 md:gap-4">
  <h3 class="uppercase text-lg md:text-xl">{title}</h3>
  <p class="text-[15px]">
    {description}
    {
      link && (
        <a href={link.href} class="underline hover:text-foreground">
          {link.label}
        </a>
      )
    }
  </p>
</div>
