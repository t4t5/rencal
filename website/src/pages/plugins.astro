---
import "../styles/index.css"
import "../styles/plugins.css"

import fs from "node:fs/promises"

import BaseLayout from "../layouts/BaseLayout.astro"
import ArrowUpRightIcon from "../icons/arrow-up-right.astro"

interface PluginIndexEntry {
  id: string
  name: string
  repo: string
  description: string
  stars: number
  preview_url?: string
}

function isPluginIndexEntry(value: unknown): value is PluginIndexEntry {
  if (typeof value !== "object" || value === null) return false
  const entry = value as Record<string, unknown>
  return (
    (entry.preview_url === undefined ||
      (typeof entry.preview_url === "string" &&
        /^https:\/\/rencal\.org\/plugin-previews\/[0-9a-f]{64}\.png$/.test(entry.preview_url))) &&
    typeof entry.id === "string" &&
    typeof entry.name === "string" &&
    typeof entry.repo === "string" &&
    typeof entry.description === "string" &&
    typeof entry.stars === "number"
  )
}

// `just web` renders mock plugins so the grid can be previewed locally.
const indexPath = import.meta.env.DEV ? "src/data/mock-plugins.json" : "public/plugins.json"
const rawIndex: unknown = JSON.parse(await fs.readFile(indexPath, "utf8"))
if (!Array.isArray(rawIndex) || !rawIndex.every(isPluginIndexEntry)) {
  throw new Error(`${indexPath} is not a valid plugin index`)
}

const plugins = rawIndex.sort(
  (left, right) =>
    right.stars - left.stars ||
    left.name.localeCompare(right.name, undefined, { sensitivity: "base" }),
)
const authorOf = (repo: string) => repo.split("/", 1)[0]
---

<BaseLayout
  title="renCal Plugins: community themes for renCal"
  description="Browse community-built plugins and themes for renCal."
>
  <section class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-6 pt-6 md:px-10">
    <header class="flex max-w-3xl flex-col gap-3">
      <h1 class="text-3xl">Plugins</h1>
      <p class="text-pretty">Browse community-built plugins for renCal.</p>
    </header>

    {
      plugins.length > 0 ? (
        <div class="plugin-grid">
          {plugins.map((plugin) => (
            <a
              class="plugin-card"
              href={`https://github.com/${plugin.repo}`}
              target="_blank"
              rel="noreferrer"
            >
              <div class="plugin-card-header">
                <img
                  class="plugin-avatar"
                  src={`https://github.com/${authorOf(plugin.repo)}.png?size=72`}
                  alt=""
                  width="36"
                  height="36"
                  loading="lazy"
                  decoding="async"
                />
                <div class="plugin-heading">
                  <h2 class="plugin-title">{plugin.name}</h2>
                  <span class="plugin-author">{authorOf(plugin.repo)}</span>
                </div>
                <ArrowUpRightIcon class="plugin-arrow" />
              </div>

              <div class="plugin-preview">
                <span class="plugin-preview-fallback">No preview</span>
                {plugin.preview_url && (
                  <img
                    src={plugin.preview_url}
                    alt={`${plugin.name} preview`}
                    width="960"
                    height="540"
                    loading="lazy"
                    decoding="async"
                    data-plugin-preview
                  />
                )}
              </div>

              <p class="plugin-description">{plugin.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="plugin-empty">No plugins yet.</p>
      )
    }
  </section>

  <script>
    for (const image of document.querySelectorAll<HTMLImageElement>("[data-plugin-preview]")) {
      const hideIfBroken = () => {
        if (image.complete && image.naturalWidth === 0) image.hidden = true
      }
      image.addEventListener("error", hideIfBroken)
      hideIfBroken()
    }
  </script>
</BaseLayout>
