---
import "../styles/index.css"
import "../styles/plugins.css"

import fs from "node:fs/promises"

import BaseLayout from "../layouts/BaseLayout.astro"
import ArrowUpRightIcon from "../icons/arrow-up-right.astro"

interface PluginIndexEntry {
  id: string
  name: string
  repo: string
  description: string
  stars: number
  released_at: string
  preview_url?: string
}

function isPluginIndexEntry(value: unknown): value is PluginIndexEntry {
  if (typeof value !== "object" || value === null) return false
  const entry = value as Record<string, unknown>
  return (
    (entry.preview_url === undefined ||
      (typeof entry.preview_url === "string" &&
        /^https:\/\/rencal\.org\/plugin-previews\/[0-9a-f]{64}\.png$/.test(entry.preview_url))) &&
    typeof entry.id === "string" &&
    typeof entry.name === "string" &&
    typeof entry.repo === "string" &&
    typeof entry.description === "string" &&
    typeof entry.stars === "number" &&
    typeof entry.released_at === "string"
  )
}

// `just web` renders mock plugins so the grid can be previewed locally.
const indexPath = import.meta.env.DEV ? "src/data/mock-plugins.json" : "public/plugins.json"
const rawIndex: unknown = JSON.parse(await fs.readFile(indexPath, "utf8"))
if (!Array.isArray(rawIndex) || !rawIndex.every(isPluginIndexEntry)) {
  throw new Error(`${indexPath} is not a valid plugin index`)
}

const plugins = rawIndex.sort(
  (left, right) =>
    right.stars - left.stars ||
    left.name.localeCompare(right.name, undefined, { sensitivity: "base" }),
)
const authorOf = (repo: string) => repo.split("/", 1)[0]
// The site is redeployed whenever the index changes, so build time is when the list was refreshed.
const builtAt = new Date()
---

<BaseLayout
  title="renCal Plugins: community themes for renCal"
  description="Browse community-built plugins and themes for renCal."
>
  <section class="mx-auto flex w-full flex-col gap-8 px-6 pt-6 md:px-10">
    <header class="flex max-w-3xl flex-col gap-3">
      <h1 class="text-3xl">Plugins</h1>
      <p class="text-pretty">Browse community-built plugins for renCal.</p>
    </header>

    <div class="flex flex-col gap-3">
      <div class="plugin-controls">
        <label class="plugin-search">
          <span class="plugin-search-slash" aria-hidden="true">/</span>
          <input
            type="search"
            id="plugin-search"
            placeholder="Search plugins…"
            aria-label="Search plugins"
            autocomplete="off"
            spellcheck="false"
          />
        </label>
        <label class="plugin-sort">
          <span class="plugin-sort-label">Sort</span>
          <select id="plugin-sort">
            <option value="stars">Most starred</option>
            <option value="latest">Latest</option>
          </select>
        </label>
      </div>
      <p class="plugin-meta">
        <span id="plugin-count" data-total={plugins.length}>
          {plugins.length}
          {plugins.length === 1 ? "plugin" : "plugins"}
        </span>
        · updated
        <time id="plugin-updated" datetime={builtAt.toISOString()}>
          {builtAt.toISOString().slice(0, 10)}
        </time>
      </p>
    </div>

    {
      plugins.length > 0 ? (
        <div class="plugin-grid" id="plugin-grid">
          {plugins.map((plugin) => (
            <a
              class="plugin-card"
              data-stars={plugin.stars}
              data-released={plugin.released_at}
              data-search={[plugin.name, plugin.repo, plugin.description].join(" ").toLowerCase()}
              href={`https://github.com/${plugin.repo}`}
              target="_blank"
              rel="noreferrer"
            >
              <div class="plugin-card-header">
                <img
                  class="plugin-avatar"
                  src={`https://github.com/${authorOf(plugin.repo)}.png?size=72`}
                  alt=""
                  width="36"
                  height="36"
                  loading="lazy"
                  decoding="async"
                />
                <div class="plugin-heading">
                  <h2 class="plugin-title">{plugin.name}</h2>
                  <span class="plugin-author">{authorOf(plugin.repo)}</span>
                </div>
                <ArrowUpRightIcon class="plugin-arrow" />
              </div>

              <div class="plugin-preview">
                <span class="plugin-preview-fallback">No preview</span>
                {plugin.preview_url && (
                  <img
                    src={plugin.preview_url}
                    alt={`${plugin.name} preview`}
                    width="960"
                    height="540"
                    loading="lazy"
                    decoding="async"
                    data-plugin-preview
                  />
                )}
              </div>

              <p class="plugin-description">{plugin.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="plugin-empty">No plugins yet.</p>
      )
    }
    <p class="plugin-empty" id="plugin-no-results" hidden>No plugins match your search.</p>
  </section>

  <script>
    for (const image of document.querySelectorAll<HTMLImageElement>("[data-plugin-preview]")) {
      const hideIfBroken = () => {
        if (image.complete && image.naturalWidth === 0) image.hidden = true
      }
      image.addEventListener("error", hideIfBroken)
      hideIfBroken()
    }

    const search = document.getElementById("plugin-search") as HTMLInputElement
    const sort = document.getElementById("plugin-sort") as HTMLSelectElement
    const count = document.getElementById("plugin-count") as HTMLElement
    const noResults = document.getElementById("plugin-no-results") as HTMLElement
    const grid = document.getElementById("plugin-grid")
    const cards = [...document.querySelectorAll<HTMLElement>(".plugin-card")]
    const total = cards.length
    const pluralize = (n: number) => `${n} ${n === 1 ? "plugin" : "plugins"}`

    function filter() {
      const terms = search.value.toLowerCase().split(/\s+/).filter(Boolean)
      let visible = 0
      for (const card of cards) {
        const match = terms.every((term) => card.dataset.search!.includes(term))
        card.hidden = !match
        if (match) visible++
      }
      count.textContent = terms.length > 0 ? `${visible} of ${pluralize(total)}` : pluralize(total)
      noResults.hidden = total === 0 || visible > 0
    }

    // Cards are rendered most-starred first, which is also the tiebreak order.
    function reorder() {
      const ordered =
        sort.value === "latest"
          ? [...cards].sort((a, b) => b.dataset.released!.localeCompare(a.dataset.released!))
          : cards
      grid?.append(...ordered)
    }

    search.addEventListener("input", filter)
    sort.addEventListener("change", reorder)
    document.addEventListener("keydown", (event) => {
      if (event.key !== "/" || event.target instanceof HTMLInputElement) return
      if (event.target instanceof HTMLSelectElement || event.metaKey || event.ctrlKey) return
      event.preventDefault()
      search.focus()
    })

    const updated = document.getElementById("plugin-updated") as HTMLTimeElement
    const minutes = Math.max(0, Math.round((Date.now() - Date.parse(updated.dateTime)) / 60_000))
    updated.textContent =
      minutes < 1
        ? "just now"
        : minutes < 60
          ? `${minutes}m ago`
          : minutes < 60 * 24
            ? `${Math.round(minutes / 60)}h ago`
            : `${Math.round(minutes / (60 * 24))}d ago`
  </script>
</BaseLayout>
