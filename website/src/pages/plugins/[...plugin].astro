---
import "../../styles/index.css"
import "../../styles/plugins.css"

import BaseLayout from "../../layouts/BaseLayout.astro"
import Button from "../../components/Button.astro"
import CloseIcon from "../../icons/close.astro"
import GitHubLogo from "../../icons/github.astro"
import RencalLogomark from "../../icons/rencal-logomark.astro"
import { loadPlugins, type PluginIndexEntry } from "../../lib/plugins"

// `/plugins/<id>/` is the plugin list with that plugin's sheet open, so plugins can be linked to.
export async function getStaticPaths() {
  const plugins = await loadPlugins()
  return [undefined, ...plugins].map((selected) => ({
    params: { plugin: selected?.id },
    props: { plugins, selected },
  }))
}

interface Props {
  plugins: PluginIndexEntry[]
  selected?: PluginIndexEntry
}

const { plugins, selected } = Astro.props
const authorOf = (repo: string) => repo.split("/", 1)[0]
// Providers run a program on the user's computer, so they are labelled apart from themes.
const kindOf = (plugin: PluginIndexEntry) =>
  plugin.contributions.includes("provider") ? "Provider" : null
const CONTRIBUTION_LABELS: Record<string, string> = { theme: "Theme", provider: "Provider" }
const sheetId = (plugin: PluginIndexEntry) => `plugin-sheet-${plugin.id}`
const LIST_TITLE = "renCal Plugins: community themes for renCal"
const titleOf = (plugin: PluginIndexEntry) =>
  `${plugin.name}: renCal plugin by ${authorOf(plugin.repo)}`
// The site is redeployed whenever the index changes, so build time is when the list was refreshed.
const builtAt = new Date()
---

<BaseLayout
  title={selected ? titleOf(selected) : LIST_TITLE}
  description={selected?.description ?? "Browse community-built plugins and themes for renCal."}
  image={selected?.preview_url}
>
  <section
    class="mx-auto flex w-full flex-col gap-8 px-6 pt-6 md:px-10"
    data-list-title={LIST_TITLE}
  >
    <header class="flex max-w-3xl flex-col gap-3">
      <h1 class="text-3xl">Plugins</h1>
      <p class="text-pretty">Browse community-built plugins for renCal.</p>
    </header>

    <div class="flex flex-col gap-3">
      <div class="plugin-controls">
        <label class="plugin-search">
          <span class="plugin-search-slash" aria-hidden="true">/</span>
          <input
            type="search"
            id="plugin-search"
            placeholder="Search plugins…"
            aria-label="Search plugins"
            autocomplete="off"
            spellcheck="false"
          />
        </label>
        <label class="plugin-sort">
          <span class="plugin-sort-label">Sort</span>
          <select id="plugin-sort">
            <option value="stars">Most starred</option>
            <option value="latest">Latest</option>
          </select>
        </label>
      </div>
      <p class="plugin-meta">
        <span id="plugin-count" data-total={plugins.length}>
          {plugins.length}
          {plugins.length === 1 ? "plugin" : "plugins"}
        </span>
        · updated
        <time id="plugin-updated" datetime={builtAt.toISOString()}>
          {builtAt.toISOString().slice(0, 10)}
        </time>
      </p>
    </div>

    {
      plugins.length > 0 ? (
        <div class="plugin-grid" id="plugin-grid">
          {plugins.map((plugin) => (
            <a
              class="plugin-card"
              data-stars={plugin.stars}
              data-released={plugin.released_at}
              data-search={[plugin.name, plugin.repo, plugin.description, kindOf(plugin) ?? ""]
                .join(" ")
                .toLowerCase()}
              data-plugin={plugin.id}
              aria-haspopup="dialog"
              href={`/plugins/${plugin.id}/`}
            >
              <div class="plugin-card-header">
                <img
                  class="plugin-avatar"
                  src={`https://github.com/${authorOf(plugin.repo)}.png?size=72`}
                  alt=""
                  width="36"
                  height="36"
                  loading="lazy"
                  decoding="async"
                />
                <div class="plugin-heading">
                  <h2 class="plugin-title">{plugin.name}</h2>
                  <span class="plugin-author">
                    {authorOf(plugin.repo)}
                    {kindOf(plugin) && ` · ${kindOf(plugin)}`}
                  </span>
                </div>
              </div>

              <div class="plugin-preview">
                <RencalLogomark class="plugin-preview-fallback" />
                {plugin.preview_url && (
                  <img
                    src={plugin.preview_url}
                    alt={`${plugin.name} preview`}
                    width="960"
                    height="540"
                    loading="lazy"
                    decoding="async"
                    data-plugin-preview
                  />
                )}
              </div>

              <p class="plugin-description">{plugin.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="plugin-empty">No plugins yet.</p>
      )
    }
    <p class="plugin-empty" id="plugin-no-results" hidden>No plugins match your search.</p>
  </section>

  {
    plugins.map((plugin) => (
      <dialog
        class="plugin-sheet"
        id={sheetId(plugin)}
        data-plugin={plugin.id}
        data-title={titleOf(plugin)}
        aria-labelledby={`${sheetId(plugin)}-title`}
      >
        <div class="plugin-sheet-body">
          <header class="plugin-sheet-header">
            <div class="plugin-sheet-title-row">
              <h2 class="plugin-sheet-title" id={`${sheetId(plugin)}-title`}>
                {plugin.name}
              </h2>
              <form method="dialog">
                <button class="plugin-sheet-close" aria-label="Close plugin details">
                  <CloseIcon />
                </button>
              </form>
            </div>
            {plugin.contributions.length > 0 && (
              <div class="plugin-badges">
                {plugin.contributions.map((kind) => (
                  <span class="plugin-badge">{CONTRIBUTION_LABELS[kind] ?? kind}</span>
                ))}
              </div>
            )}
            <p class="plugin-sheet-description">{plugin.description}</p>
          </header>

          <div class="plugin-sheet-actions">
            <Button
              href={`rencal://plugin/install?repo=${encodeURIComponent(plugin.repo)}`}
              variant="primary"
            >
              Install in renCal
            </Button>
            <Button href={`https://github.com/${plugin.repo}`} target="_blank" rel="noreferrer">
              <GitHubLogo class="w-4" />
              View on GitHub
            </Button>
          </div>

          {plugin.preview_url && (
            <div class="plugin-preview">
              <RencalLogomark class="plugin-preview-fallback" />
              <img
                src={plugin.preview_url}
                alt={`${plugin.name} preview`}
                width="960"
                height="540"
                loading="lazy"
                decoding="async"
                data-plugin-preview
              />
            </div>
          )}

          <section class="plugin-sheet-details">
            <h3>Details</h3>
            <dl>
              <dt>Author</dt>
              <dd>{authorOf(plugin.repo)}</dd>
              <dt>Repository</dt>
              <dd>{plugin.repo}</dd>
              <dt>Stars</dt>
              <dd>{plugin.stars}</dd>
              <dt>Released</dt>
              <dd>
                <time datetime={plugin.released_at}>{plugin.released_at.slice(0, 10)}</time>
              </dd>
            </dl>
          </section>
        </div>
      </dialog>
    ))
  }

  <script>
    for (const image of document.querySelectorAll<HTMLImageElement>("[data-plugin-preview]")) {
      const hideIfBroken = () => {
        if (image.complete && image.naturalWidth === 0) image.hidden = true
      }
      image.addEventListener("error", hideIfBroken)
      hideIfBroken()
    }

    const search = document.getElementById("plugin-search") as HTMLInputElement
    const sort = document.getElementById("plugin-sort") as HTMLSelectElement
    const count = document.getElementById("plugin-count") as HTMLElement
    const noResults = document.getElementById("plugin-no-results") as HTMLElement
    const grid = document.getElementById("plugin-grid")
    const cards = [...document.querySelectorAll<HTMLElement>(".plugin-card")]
    const total = cards.length
    const pluralize = (n: number) => `${n} ${n === 1 ? "plugin" : "plugins"}`

    function filter() {
      const terms = search.value.toLowerCase().split(/\s+/).filter(Boolean)
      let visible = 0
      for (const card of cards) {
        const match = terms.every((term) => card.dataset.search!.includes(term))
        card.hidden = !match
        if (match) visible++
      }
      count.textContent = terms.length > 0 ? `${visible} of ${pluralize(total)}` : pluralize(total)
      noResults.hidden = total === 0 || visible > 0
    }

    // Cards are rendered most-starred first, which is also the tiebreak order.
    function reorder() {
      const ordered =
        sort.value === "latest"
          ? [...cards].sort((a, b) => b.dataset.released!.localeCompare(a.dataset.released!))
          : cards
      grid?.append(...ordered)
    }

    const sheets = new Map(
      [...document.querySelectorAll<HTMLDialogElement>(".plugin-sheet")].map((sheet) => [
        sheet.dataset.plugin!,
        sheet,
      ]),
    )
    const listTitle = document.querySelector<HTMLElement>("[data-list-title]")!.dataset.listTitle!
    // `/plugins/<id>/` → `<id>`
    const pluginInUrl = () => location.pathname.split("/")[2] || null
    const pluginPath = (id: string | null) => (id ? `/plugins/${id}/` : "/plugins/")

    function openSheet(sheet: HTMLDialogElement, animate: boolean) {
      if (animate) return sheet.showModal()
      sheet.dataset.instant = ""
      sheet.showModal()
      // Commit the open styles before transitions return, so closing still animates.
      void sheet.offsetWidth
      delete sheet.dataset.instant
    }

    // The URL is the source of truth for which sheet is open.
    function syncSheetToUrl({ animate = true } = {}) {
      const id = pluginInUrl()
      for (const [pluginId, sheet] of sheets) {
        if (pluginId === id) {
          if (!sheet.open) openSheet(sheet, animate)
        } else if (sheet.open) {
          sheet.close()
        }
      }
      document.title = (id && sheets.get(id)?.dataset.title) || listTitle
    }

    for (const card of cards) {
      card.addEventListener("click", (event) => {
        // Modified clicks open the plugin's link in a new tab.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
        const id = card.dataset.plugin!
        if (!sheets.has(id)) return
        event.preventDefault()
        history.pushState({ plugin: id }, "", pluginPath(id))
        syncSheetToUrl()
      })
    }
    for (const [id, sheet] of sheets) {
      // The body fills the panel, so clicks landing on the dialog itself come from the backdrop.
      sheet.addEventListener("click", (event) => {
        if (event.target === sheet) sheet.close()
      })
      sheet.addEventListener("close", () => {
        // Back/forward already changed the URL.
        if (pluginInUrl() !== id) return
        // Pop the entry the card click pushed, so Back doesn't reopen the sheet.
        if (history.state?.plugin === id) {
          history.back()
        } else {
          history.replaceState(null, "", pluginPath(null))
          document.title = listTitle
        }
      })
    }
    window.addEventListener("popstate", () => syncSheetToUrl())
    // A linked plugin is shown already open rather than sliding in.
    syncSheetToUrl({ animate: false })

    search.addEventListener("input", filter)
    sort.addEventListener("change", reorder)
    document.addEventListener("keydown", (event) => {
      if (event.key !== "/" || event.target instanceof HTMLInputElement) return
      if (event.target instanceof HTMLSelectElement || event.metaKey || event.ctrlKey) return
      if (document.querySelector(".plugin-sheet[open]")) return
      event.preventDefault()
      search.focus()
    })

    const updated = document.getElementById("plugin-updated") as HTMLTimeElement
    const minutes = Math.max(0, Math.round((Date.now() - Date.parse(updated.dateTime)) / 60_000))
    updated.textContent =
      minutes < 1
        ? "just now"
        : minutes < 60
          ? `${minutes}m ago`
          : minutes < 60 * 24
            ? `${Math.round(minutes / 60)}h ago`
            : `${Math.round(minutes / (60 * 24))}d ago`
  </script>
</BaseLayout>
